---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import { booking } from '@/data/schedule-meta';
---

<PageLayout
  title="Book a Class"
  lead="Reserve your place in an upcoming class. Use your pass at checkout."
  description="Book a yoga class at the Toronto Sivananda Yoga Vedanta Centre via Acuity Scheduling."
>
  <div class="mb-6 flex flex-wrap gap-3">
    <Button href="/passes" variant="secondary">Passes &amp; gift cards</Button>
    <Button href="/schedule" variant="ghost">View schedule</Button>
  </div>

  <div class="overflow-hidden rounded-xl border border-border bg-card">
    <iframe
      src={booking.iframe}
      title="Schedule an appointment with Toronto Sivananda Yoga Vedanta Centre"
      width="100%"
      height="800"
      frameborder="0"
      loading="lazy"
      class="block w-full"></iframe>
  </div>

  <p class="mt-4 text-sm text-muted-foreground">
    Trouble loading the scheduler? <a
      href={booking.inPerson}
      target="_blank"
      rel="noopener noreferrer"
      class="text-primary hover:opacity-80">Open booking in a new tab</a
    >.
  </p>
</PageLayout>

{/* Acuity embed helper: enables auto-resizing of the iframe above. */}
<script is:inline src="https://embed.acuityscheduling.com/js/embed.js" type="text/javascript"
></script>

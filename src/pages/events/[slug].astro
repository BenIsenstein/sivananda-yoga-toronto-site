---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Prose from '@/components/Prose.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { getVisibleEvents, formatEventDate, type EventEntry } from '@/lib/events';
import { eventSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const events = await getVisibleEvents();
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const dateLabel = formatEventDate(data);
const singleDay = !!data.start && !data.end;

// Absolute, optimized OG/schema image URL (when the event has an image).
let ogImage: string | undefined;
if (data.image && Astro.site) {
  const built = await getImage({ src: data.image, format: 'webp', width: 1200 });
  ogImage = new URL(built.src, Astro.site).href;
}

// Meta description: first non-empty line of the body, else a sensible fallback.
const rawBody = event.body ?? '';
const bodyExcerpt = rawBody
  .replace(/[#>*_`-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);
const metaDescription =
  bodyExcerpt || [data.title, dateLabel, data.teacher].filter(Boolean).join(' · ') || data.title;

const jsonLd = eventSchema(event, Astro.site, ogImage);
---

<PageLayout
  title={data.title}
  description={metaDescription}
  heroImage={data.image}
  heroAlt={data.imageAlt ?? data.title}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
  narrow
>
  <div class="mb-6 flex flex-wrap gap-2">
    {data.categories.map((category) => <Badge variant="muted">{category}</Badge>)}
  </div>

  <dl class="mb-8 grid gap-4 rounded-xl border border-border bg-muted/40 p-6 sm:grid-cols-2">
    {
      (dateLabel || data.ongoing) && (
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Dates</dt>
          <dd class="mt-1 text-foreground">
            {data.ongoing ? 'Announced through the year' : dateLabel}
          </dd>
        </div>
      )
    }
    {
      singleDay && data.time && (
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Time</dt>
          <dd class="mt-1 text-foreground">{data.time}</dd>
        </div>
      )
    }
    {
      data.price && (
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Price</dt>
          <dd class="mt-1 text-foreground">{data.price}</dd>
        </div>
      )
    }
    {
      data.teacher && (
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Teacher</dt>
          <dd class="mt-1 text-foreground">{data.teacher}</dd>
        </div>
      )
    }
  </dl>

  <Prose>
    <Content />
  </Prose>

  {
    (data.registerUrl || data.registerNote) && (
      <div class="mt-8 space-y-3">
        {data.registerUrl && (
          <Button href={data.registerUrl} external>
            Register
          </Button>
        )}
        {data.registerNote && <p class="text-sm text-muted-foreground">{data.registerNote}</p>}
      </div>
    )
  }

  <div class="mt-10">
    <a href="/events" class="text-sm font-medium text-primary hover:underline">
      &larr; Back to all events
    </a>
  </div>
</PageLayout>

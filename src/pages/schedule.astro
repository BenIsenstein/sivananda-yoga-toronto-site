---
import PageLayout from '@/layouts/PageLayout.astro';
import ScheduleGrid from '@/components/ScheduleGrid.astro';
import ClassTypeLegend from '@/components/ClassTypeLegend.astro';
import Button from '@/components/ui/Button.astro';
import { inPersonClasses, booking } from '@/data/schedule-meta';
---

<PageLayout
  title="Class Schedule"
  lead="Daily in-person Hatha yoga classes at 77 Harbord Street. Click a class to register with your pass."
  description="Weekly in-person yoga class schedule at the Toronto Sivananda Yoga Vedanta Centre."
>
  <div
    class="mb-8 flex flex-col items-start justify-between gap-4 rounded-xl border border-border bg-muted/40 p-6 sm:flex-row sm:items-center"
  >
    <p class="max-w-2xl text-sm text-muted-foreground">
      <strong class="text-foreground">To register:</strong> click the class you wish to attend, use your
      pass, and you'll receive a confirmation email. Drop-in classes are practice-based — small, teacher-supported
      groups offer the greatest benefits for body and mind. The weekly schedule is subject to change;
      please check back regularly.
    </p>
    <div class="flex shrink-0 flex-wrap gap-3">
      <Button href="/book">Book a class</Button>
      <Button href="/passes" variant="secondary">Passes &amp; gift cards</Button>
    </div>
  </div>

  <ScheduleGrid classes={inPersonClasses} />

  <section class="mt-14">
    <h2 class="mb-5 font-serif text-3xl text-foreground">Class descriptions</h2>
    <ClassTypeLegend classes={inPersonClasses} />
  </section>

  <section
    class="mt-14 rounded-xl border border-border bg-card p-6 text-center"
    aria-label="New to yoga"
  >
    <h2 class="font-serif text-2xl text-foreground">New to yoga?</h2>
    <p class="mx-auto mt-2 max-w-xl text-muted-foreground">
      It's best to start with our introductory courses, which offer step-by-step instruction in the
      foundations of Hatha Yoga postures, breathing exercises and relaxation.
    </p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <Button href="/new-to-yoga">Introductory courses</Button>
      <Button href="/online" variant="secondary">Online schedule</Button>
      <Button href={booking.inPerson} external variant="ghost">Book on Acuity</Button>
    </div>
    <p class="mt-6 text-sm text-muted-foreground italic">
      Health is wealth. Peace of mind is happiness. Yoga shows the way.
    </p>
  </section>
</PageLayout>

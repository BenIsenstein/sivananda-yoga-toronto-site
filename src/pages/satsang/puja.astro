---
import PageLayout from '@/layouts/PageLayout.astro';
import Prose from '@/components/Prose.astro';
---

<PageLayout
  title="Puja"
  lead="A traditional ceremony of worship — free and open to all."
  description="Weekly puja ceremony at the Toronto Sivananda Yoga Vedanta Centre — Saturdays at 9 am."
  narrow
>
  <Prose>
    <p>
      Puja is a traditional ceremony, a form of worship. While different mantras are chanted,
      ablutions are done to all deities with different elements such as milk, water and other
      traditional items, followed by decorating the deities and Arati.
    </p>
    <p>
      <strong>Free of charge and open to all. Every Saturday, 9:00 am. Duration: 1 hour.</strong>
    </p>
  </Prose>
</PageLayout>

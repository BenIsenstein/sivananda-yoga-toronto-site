---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<PageLayout
  title="Workshops & Events"
  lead="Our full workshops and events calendar is coming soon to the new site."
  description="Yoga workshops, courses and events at the Toronto Sivananda Yoga Vedanta Centre."
>
  <p class="text-muted-foreground">
    We host meditation courses, kirtan, chair yoga, seasonal gatherings and more throughout the
    year. The new events calendar is on its way. In the meantime, explore our courses.
  </p>
  <div class="mt-6">
    <Button href="/courses">Browse courses</Button>
  </div>
</PageLayout>

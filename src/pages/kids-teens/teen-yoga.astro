---
import PageLayout from '@/layouts/PageLayout.astro';
import Prose from '@/components/Prose.astro';
import hero from '@/assets/kids-teens/teen-yoga.jpg';
---

<PageLayout
  title="Teen Yoga & Meditation"
  lead="A course for teens (ages 14–16) — yoga, breathing, relaxation and meditation for well-being."
  description="Teen yoga and meditation course (ages 14–16) at the Toronto Sivananda Yoga Vedanta Centre."
  heroImage={hero}
  heroAlt="Teen practising a headstand"
  narrow
>
  <Prose>
    <p>
      This course teaches teens basic yoga postures, breathing exercises, relaxation and simple
      meditation practice for physical and mental well-being. Teens are encouraged to practise at
      home and use yoga techniques to stay calm and focused.
    </p>
    <p>
      During the course, we also discuss a yogic perspective on mental health and issues that teens
      often face, such as school stress, anxiety, addiction, body image and relationships.
    </p>
    <p>
      This is a 6-week course meeting once per week on Saturday mornings. Course dates are announced
      through the year — please check upcoming events or contact us.
    </p>
  </Prose>
</PageLayout>

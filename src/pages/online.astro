---
import PageLayout from '@/layouts/PageLayout.astro';
import ScheduleGrid from '@/components/ScheduleGrid.astro';
import ClassTypeLegend from '@/components/ClassTypeLegend.astro';
import Button from '@/components/ui/Button.astro';
import { onlineClasses, booking } from '@/data/schedule-meta';
---

<PageLayout
  title="Online Classes"
  lead="Join us for live online Hatha yoga over Zoom, wherever you are."
  description="Weekly online yoga class schedule (Zoom) with the Toronto Sivananda Yoga Vedanta Centre."
>
  <div
    class="mb-8 flex flex-col items-start justify-between gap-4 rounded-xl border border-border bg-muted/40 p-6 sm:flex-row sm:items-center"
  >
    <p class="max-w-2xl text-sm text-muted-foreground">
      <strong class="text-foreground">To register:</strong> click the class you wish to attend, use your
      pass, and you'll receive a Zoom link in the confirmation email. Registration closes 15 minutes before
      class time. The weekly schedule is subject to change.
    </p>
    <div class="flex shrink-0 flex-wrap gap-3">
      <Button href={booking.online} external>Book online</Button>
      <Button href="/passes" variant="secondary">Passes &amp; gift cards</Button>
    </div>
  </div>

  <ScheduleGrid classes={onlineClasses} />

  <section class="mt-14">
    <h2 class="mb-5 font-serif text-3xl text-foreground">Class descriptions</h2>
    <ClassTypeLegend classes={onlineClasses} />
  </section>

  <p class="mt-10 text-sm text-muted-foreground">
    Prefer to practise in person? See our <a href="/schedule" class="text-primary hover:opacity-80"
      >in-person class schedule</a
    >.
  </p>
</PageLayout>

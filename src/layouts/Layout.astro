---
import '../styles/global.css';
import { site } from '@/config/site';
import Seo from '@/components/Seo.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute OG image URL (optional). */
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image,
  imageAlt,
  ogType,
  noindex,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.shortName}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <Seo
      title={pageTitle}
      description={description}
      image={image}
      imageAlt={imageAlt}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    {/* No-flash theme init: set .dark before first paint */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const dark = stored ? stored === 'dark' : systemDark;
          document.documentElement.classList.toggle('dark', dark);
        } catch (err) {
          console.debug('theme init skipped', err);
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <slot />
  </body>
</html>

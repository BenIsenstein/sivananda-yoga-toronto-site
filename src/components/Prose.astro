---
/**
 * Prose — readable rich-text container for migrated copy. Light + dark aware.
 * Styles headings, paragraphs, lists and links via semantic tokens.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={[
    'max-w-none space-y-4 leading-relaxed text-foreground',
    '[&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-3xl [&_h2]:text-foreground',
    '[&_h3]:mt-6 [&_h3]:font-serif [&_h3]:text-2xl [&_h3]:text-foreground',
    '[&_p]:text-muted-foreground',
    '[&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:opacity-80',
    '[&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6 [&_ul]:text-muted-foreground',
    '[&_ol]:list-decimal [&_ol]:space-y-1 [&_ol]:pl-6 [&_ol]:text-muted-foreground',
    '[&_strong]:font-semibold [&_strong]:text-foreground',
    '[&_blockquote]:border-l-4 [&_blockquote]:border-border [&_blockquote]:pl-4 [&_blockquote]:italic',
    className,
  ]}
>
  <slot />
</div>

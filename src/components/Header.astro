---
/** Site header: multi-level nav, full-screen mobile menu, theme toggle. Light + dark aware. */
import { mainNav, site } from '@/config/site';
import Button from '@/components/ui/Button.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

const { contact, social } = site;
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="font-serif text-lg font-semibold text-foreground sm:text-xl">
      {site.shortName}
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        mainNav.map((item) =>
          item.children ? (
            <div class="group relative">
              <a
                href={item.href ?? '#'}
                class="inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
              >
                {item.label}
                <svg
                  class="size-3.5 text-muted-foreground"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </a>
              <div class="invisible absolute left-0 top-full min-w-56 rounded-lg border border-border bg-popover p-1.5 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    target={child.external ? '_blank' : undefined}
                    rel={child.external ? 'noopener noreferrer' : undefined}
                    class="block rounded-md px-3 py-2 text-sm text-popover-foreground transition-colors hover:bg-muted"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted"
            >
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="flex items-center gap-2">
      <Button href={site.book} size="sm" class="hidden sm:inline-flex">Book</Button>
      <ThemeToggle />
      {/* Mobile menu toggle (hamburger <-> X) */}
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex size-10 items-center justify-center rounded-md border border-border text-foreground transition-colors hover:bg-muted lg:hidden"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          class="size-5"
          data-icon="open"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg
        >
        <svg
          class="hidden size-5"
          data-icon="close"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
        >
      </button>
    </div>
  </div>
</header>

{
  /*
  Full-screen mobile menu — rendered as a SIBLING of <header> (not inside it).
  The header uses backdrop-filter, which would otherwise become the containing
  block for this `fixed` element and collapse it to the header's height.
  Anchored below the sticky header (top-16); fills the rest of the viewport.
*/
}
<div
  id="mobile-menu"
  class="fixed inset-x-0 bottom-0 top-16 z-40 hidden translate-y-2 opacity-0 transition-[opacity,transform] duration-200 ease-out lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="flex h-full flex-col overflow-y-auto bg-background">
    <nav class="flex flex-1 flex-col gap-1 px-4 py-6 sm:px-6" aria-label="Mobile">
      {
        mainNav.map((item) =>
          item.children ? (
            <details class="group border-b border-border/60">
              <summary class="flex cursor-pointer items-center justify-between rounded-md px-3 py-3 text-base font-medium text-foreground hover:bg-muted">
                {item.label}
                <svg
                  class="size-5 text-muted-foreground transition-transform group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="ml-3 flex flex-col border-l border-border pb-2 pl-3">
                {item.href && (
                  <a
                    href={item.href}
                    class="mobile-link rounded-md px-3 py-2 text-sm font-medium text-foreground hover:bg-muted"
                  >
                    {item.label} overview
                  </a>
                )}
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    target={child.external ? '_blank' : undefined}
                    rel={child.external ? 'noopener noreferrer' : undefined}
                    class="mobile-link rounded-md px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={item.href}
              class="mobile-link border-b border-border/60 rounded-md px-3 py-3 text-base font-medium text-foreground hover:bg-muted"
            >
              {item.label}
            </a>
          )
        )
      }

      <Button href={site.book} class="mobile-link mt-5">Book a class</Button>
    </nav>

    {/* Menu footer: contact + socials */}
    <div class="border-t border-border px-4 py-6 text-sm text-muted-foreground sm:px-6">
      <address class="not-italic">
        <a href={contact.phoneHref} class="mobile-link font-medium text-foreground hover:underline">
          {contact.phone}
        </a>
        <p class="mt-1">
          {contact.address}, {contact.city}, {contact.region}
          {contact.postalCode}
        </p>
      </address>
      <div class="mt-4 flex items-center gap-4">
        <a
          href={social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground"
          aria-label="Instagram"
        >
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M17.5 6.5h.01"></path>
          </svg>
        </a>
        <a
          href={social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground"
          aria-label="Facebook"
        >
          <svg class="size-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
        <a
          href={social.youtube}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground"
          aria-label="YouTube"
        >
          <svg
            class="size-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"
            ></path>
            <path d="m9.75 15.02 5.75-3.27-5.75-3.27z" fill="currentColor" stroke="none"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('mobile-menu-btn');
  const openIcon = openBtn?.querySelector<SVGElement>('[data-icon="open"]');
  const closeIcon = openBtn?.querySelector<SVGElement>('[data-icon="close"]');
  const DESKTOP = window.matchMedia('(min-width: 1024px)');

  let isOpen = false;

  /** All focusable elements currently inside the menu. */
  const focusable = () =>
    Array.from(
      menu?.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])'
      ) ?? []
    ).filter((el) => el.offsetParent !== null);

  function setOpen(open: boolean) {
    if (!menu || !openBtn) return;
    isOpen = open;

    // Toggle visibility, then animate on the next frame so the transition runs.
    if (open) {
      menu.classList.remove('hidden');
      requestAnimationFrame(() => menu.classList.remove('translate-y-2', 'opacity-0'));
    } else {
      menu.classList.add('translate-y-2', 'opacity-0');
      // Hide after the transition so it's removed from the a11y tree.
      window.setTimeout(() => {
        if (!isOpen) menu.classList.add('hidden');
      }, 200);
    }

    openBtn.setAttribute('aria-expanded', String(open));
    openBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      focusable()[0]?.focus();
    } else {
      openBtn.focus();
    }
  }

  openBtn?.addEventListener('click', () => setOpen(!isOpen));

  // Close when a nav link/CTA is tapped.
  menu
    ?.querySelectorAll('.mobile-link')
    .forEach((el) => el.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    if (e.key === 'Escape') {
      setOpen(false);
      return;
    }
    // Trap Tab within the menu.
    if (e.key === 'Tab') {
      const items = focusable();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  // Auto-close if the viewport grows to desktop.
  DESKTOP.addEventListener('change', (e) => e.matches && isOpen && setOpen(false));
</script>

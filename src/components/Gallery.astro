---
/**
 * Gallery — responsive grid of optimized images (astro:assets). Light + dark aware.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  src: ImageMetadata;
  alt: string;
}
interface Props {
  images: Item[];
  class?: string;
}

const { images, class: className } = Astro.props;
---

<div class:list={['grid grid-cols-2 gap-4 sm:grid-cols-3', className]}>
  {
    images.map((img) => (
      <Image
        src={img.src}
        alt={img.alt}
        loading="lazy"
        class="aspect-4/3 w-full rounded-lg border border-border object-cover"
      />
    ))
  }
</div>

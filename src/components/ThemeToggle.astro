---
/**
 * ThemeToggle — light / dark / system, vanilla JS, no React.
 * Pairs with the no-flash init script in Layout.astro (sets `.dark` on <html>).
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex size-10 items-center justify-center rounded-md border border-border text-foreground transition-colors hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
  aria-label="Toggle color theme"
  title="Toggle light/dark theme"
>
  <!-- Sun (shown in dark mode) -->
  <svg
    class="hidden size-5 dark:block"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <!-- Moon (shown in light mode) -->
  <svg
    class="size-5 dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  const toggle = document.getElementById('theme-toggle');

  function apply(theme: 'light' | 'dark') {
    document.documentElement.classList.toggle('dark', theme === 'dark');
  }

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const next = isDark ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    apply(next);
  });
</script>

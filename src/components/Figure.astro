---
/**
 * Figure — an optimized image (astro:assets) with rounded styling and optional caption.
 * Light + dark aware (border + muted caption use tokens).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt, caption, class: className, loading = 'lazy' } = Astro.props;
---

<figure class:list={['overflow-hidden', className]}>
  <Image
    src={src}
    alt={alt}
    loading={loading}
    class="h-full w-full rounded-xl border border-border object-cover"
  />
  {caption && <figcaption class="mt-2 text-sm text-muted-foreground">{caption}</figcaption>}
</figure>
